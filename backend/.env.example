# Copy this file to backend/.env and fill in the values.
APP_ENV=development          # "production" on the live server
DEBUG=true                   # always false in production
HOST=127.0.0.1               # 0.0.0.0 on a server
PORT=8000

# 32+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Empty = SQLite file backend/instance/carbonlens.db (local use)
# Production: PostgreSQL connection string, e.g. from Neon
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Sessions (defaults shown)
ACCESS_TOKEN_MINUTES=15
SESSION_HOURS=12
REMEMBER_DAYS=30
# COOKIE_SECURE=true         # forced on when APP_ENV=production

# Only if the frontend is hosted on a different domain than the API:
# ALLOWED_ORIGINS=https://carbonlens.example.com

# Email (Brevo, free 300 emails/day): https://app.brevo.com → SMTP & API → API keys
BREVO_API_KEY=
BREVO_FROM_EMAIL=sawie.info@gmail.com
BREVO_FROM_NAME=CarbonLens by SAWiE
SUPPORT_EMAIL=sawie.info@gmail.com
CONTACT_EMAIL_INFO=sawie.info@gmail.com
CONTACT_EMAIL_TECH=sawie.info@gmail.com

# Assistant (Groq, free): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
