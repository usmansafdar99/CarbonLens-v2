# CarbonLens - production environment (Railway + Supabase)
# Do NOT commit the real .env. Paste these into Railway -> Variables -> Raw Editor.
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
# Do NOT set PORT on Railway - Railway injects it automatically.

# 32+ random chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Supabase -> Project Settings -> Database -> Connection string -> URI -> Session pooler
# Use the pooler host (port 5432), NOT db.<ref>.supabase.co (that one is IPv6-only).
# URL-encode special characters in the password: @ = %40, # = %23, / = %2F
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

COOKIE_SECURE=true
# Only if the frontend is served from a different domain than the API:
# ALLOWED_ORIGINS=https://carbonlens.sawie.io

BREVO_API_KEY=
BREVO_FROM_EMAIL=sawie.info@gmail.com
BREVO_FROM_NAME=CarbonLens by SAWiE
SUPPORT_EMAIL=sawie.info@gmail.com
CONTACT_EMAIL_INFO=sawie.info@gmail.com
CONTACT_EMAIL_TECH=sawie.info@gmail.com

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
